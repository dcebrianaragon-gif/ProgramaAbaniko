{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Abrir Programa Abaniko",
      "program": "${workspaceFolder}/backend/server.js",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "restart": true,
      "env": {
        "PORT": "3000"
      },
      "runtimeArgs": [
        "--require",
        "${workspaceFolder}/.vscode/open-programa.js"
      ],
      "serverReadyAction": {
        "pattern": "Programa Abaniko disponible en (http://127\\.0\\.0\\.1:3000)",
        "uriFormat": "%s/Index.html",
        "action": "openExternally"
      }
    }
  ]
}
